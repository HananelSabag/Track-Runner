<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Speed comes from the watch's own GNSS receiver. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Countdown and result are signalled on the wrist, so the runner need not look. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The test must keep running while the display is off, which on a watch is most of the time. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Heart rate grades how hard the work was, and shows recovery during a rest. A session runs without it. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Needed to bind to Health Services on the watch. -->
    <queries>
        <package android:name="com.google.android.wearable.healthservices" />
    </queries>

    <application
        android:name=".FastWearApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- The watch app records on its own; the phone app is optional. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Ambient (always-on) mode. Not required: without it the app behaves as an ordinary one. -->
        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <service
            android:name=".sprint.SprintService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".record.RecordingService"
            android:exported="false"
            android:foregroundServiceType="location|health" />

        <!--
            Woken by Play services when the phone confirms a session or asks for them again.
            Only those two paths: the sessions this watch writes itself would wake it too.
        -->
        <service
            android:name=".sync.PhoneListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/fast/ack/"
                    android:scheme="wear" />
                <data
                    android:host="*"
                    android:path="/fast/resync"
                    android:scheme="wear" />
            </intent-filter>
            <!-- The phone answering a start: measuring along, or unable to. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/fast/link/"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
