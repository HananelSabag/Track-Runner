    <string name="reference_title">מדידה מהטלפון</string>
    <string name="reference_subtitle">להקליט את ה-GPS של הטלפון לצד השעון, כדי להשוות ביניהם</string>
    <string name="reference_notification">מודד עם ה-GPS של הטלפון</string>
    <string name="reference_what_title">כלי בדיקה</string>
    <string name="reference_what_text">מקליט את ה-GPS של הטלפון עצמו, בקצב הכי גבוה שהוא נותן, כדי שאותה ריצה תימדד פעמיים: בשעון ובטלפון. ההקלטות לא מופיעות בהיסטוריה.</string>
    <string name="reference_step_1">1. צא החוצה ולחץ כאן \"התחל\". חכה שתופיע מהירות.</string>
    <string name="reference_step_2">2. התחל \"ריצה\" בשעון.</string>
    <string name="reference_step_3">3. הטלפון ביד או בכיס צמוד. רוץ.</string>
    <string name="reference_step_4">4. סיים בשעון, ואז לחץ כאן \"עצור\".</string>
