    <!-- Reference measurement: the phone's GPS recorded next to the watch's -->
    <string name="reference_title">Measure with the phone</string>
    <string name="reference_subtitle">Record the phone\'s GPS next to the watch\'s, to compare them</string>
    <string name="reference_notification">Measuring with the phone\'s GPS</string>
    <string name="reference_what_title">A test tool</string>
    <string name="reference_what_text">Records this phone\'s own GPS, as fast as it delivers, so the same run can be measured twice: by the watch and by the phone. The recordings do not appear in the history.</string>
    <string name="reference_step_1">1. Go outside and press Start here. Wait for a speed to appear.</string>
    <string name="reference_step_2">2. Start a Run on the watch.</string>
    <string name="reference_step_3">3. Phone in your hand or a tight pocket. Run.</string>
    <string name="reference_step_4">4. Finish on the watch, then press Stop here.</string>
